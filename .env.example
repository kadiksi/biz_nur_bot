# Скопируйте в .env и заполните. .env не коммитится.

# База данных (по умолчанию SQLite в ./data/biz.db; для Postgres: postgresql+asyncpg://user:pass@host/db)
# DATABASE_URL=sqlite+aiosqlite:///./data/biz.db

# Telegram ID владельца — единственный, кто пишет главному боту и меняет планы
OWNER_TELEGRAM_ID=

TIMEZONE=Europe/Moscow
# Через сколько часов метка свежести данных становится «устаревшей»
SYNC_STALE_HOURS=24

# Claude (шаги 5–6)
ANTHROPIC_API_KEY=
MODEL_MAIN=claude-opus-5-5
MODEL_DEPARTMENTS=claude-sonnet-5-5
# Глубина рассуждений главного бота: low | medium | high
MAIN_EFFORT=medium
# Если модель откажется отвечать, API само повторит запрос на запасной модели
CLAUDE_FALLBACKS=true

# Сайт (только локальная сеть). SITE_URL — если адрес определяется неверно
SITE_PORT=8000
# SITE_URL=http://192.168.1.10:8000

# 1С — только чтение через стандартный интерфейс OData. По три строки на каждую базу,
# ИМЯ — любое латиницей (UT, BUH…). Пользователю 1С хватит прав только на чтение.
# ONEC_UT_URL=http://1c-server/ut/odata/standard.odata
# ONEC_UT_USER=bot
# ONEC_UT_PASSWORD=
# ONEC_UT_COMPANY=alpha         # необязательно: какой компании эта база
# ONEC_UT_VERIFY_SSL=false      # необязательно: самоподписанный сертификат https
# Как часто подтягивать факты из 1С, минут (0 — только по просьбе боту)
ONEC_SYNC_MINUTES=60
# ONEC_TIMEOUT=60

# Токены ботов (шаги 4–6)
BOT_TOKEN_MAIN=
BOT_TOKEN_SALES=
BOT_TOKEN_MARKETING=
BOT_TOKEN_WAREHOUSE=
BOT_TOKEN_FINANCE=
